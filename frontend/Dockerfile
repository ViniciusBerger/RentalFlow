FROM node:20-alpine AS builder

WORKDIR /app

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

ARG VITE_CONTRACT_QUESTIONNAIRE_ENABLED
ENV VITE_CONTRACT_QUESTIONNAIRE_ENABLED=$VITE_CONTRACT_QUESTIONNAIRE_ENABLED
ARG VITE_CONTRACT_WORKSPACE_ENABLED
ENV VITE_CONTRACT_WORKSPACE_ENABLED=$VITE_CONTRACT_WORKSPACE_ENABLED
ARG VITE_CONTRACT_FINALIZATION_ENABLED
ENV VITE_CONTRACT_FINALIZATION_ENABLED=$VITE_CONTRACT_FINALIZATION_ENABLED
ARG VITE_CONTRACT_CANCELLATIONS_ENABLED
ENV VITE_CONTRACT_CANCELLATIONS_ENABLED=$VITE_CONTRACT_CANCELLATIONS_ENABLED
ARG VITE_CONTRACT_AMENDMENTS_ENABLED
ENV VITE_CONTRACT_AMENDMENTS_ENABLED=$VITE_CONTRACT_AMENDMENTS_ENABLED
ARG VITE_CONTRACT_CHANGES_ENABLED
ENV VITE_CONTRACT_CHANGES_ENABLED=$VITE_CONTRACT_CHANGES_ENABLED
ARG VITE_CONTRACT_BOOKING_DRAFTS_ENABLED
ENV VITE_CONTRACT_BOOKING_DRAFTS_ENABLED=$VITE_CONTRACT_BOOKING_DRAFTS_ENABLED

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build


FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
