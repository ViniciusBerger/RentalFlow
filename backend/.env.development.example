# Local development ONLY. Copy these values into backend/.env.
# Never enable on deployed/staging/production servers.
NODE_ENV=development
ENABLE_DEV_LOGIN=true
DEV_LOGIN_EMAIL=test@test.com
DEV_LOGIN_PASSWORD=test123
DEV_AUTH_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_LOCAL_SECRET
# Required: a SEPARATE local PostgreSQL database, NEVER production!
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentalflow_dev
# Existing Firebase settings remain necessary if testing Firebase sign-in too.
